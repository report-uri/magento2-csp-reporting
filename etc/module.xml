<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="ReportUri_CspReporting">
        <sequence>
            <!-- Our config group is merged into the section Magento_Csp declares, and the
                 endpoints we write are read by its ConfigManager, so it has to load first.
                 Checkout and Sales declare the two per-page fields we also write. -->
            <module name="Magento_Csp"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Sales"/>
        </sequence>
    </module>
</config>
