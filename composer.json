{
    "name": "report-uri/magento2-csp-reporting",
    "description": "Beta. Fills in the four CSP Report URI fields Magento ships empty, so violation reports reach a collector instead of nowhere.",
    "type": "magento2-module",
    "license": "MIT",
    "homepage": "https://report-uri.com/solutions/magento",
    "support": {
        "issues": "https://github.com/report-uri/magento2-csp-reporting/issues",
        "docs": "https://docs.report-uri.com/platforms/adobe-commerce/"
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=102.0.0",
        "magento/module-backend": ">=101.0.0",
        "magento/module-config": ">=101.1.0",
        "magento/module-csp": ">=100.4.3-p9 <100.4.4 || >=100.4.4-p8 <100.4.5 || >=100.4.5-p6 <100.4.6 || >=100.4.6",
        "magento/module-store": ">=101.0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ReportUri\\CspReporting\\": ""
        }
    }
}
